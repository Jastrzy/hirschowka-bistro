{
  "rewrites": [
    {
      "source": "/lunchowki",
      "destination": "/lunchowki.html"
    },
    {
      "source": "/lojalnosc",
      "destination": "/lojalnosc.html"
    },
    {
      "source": "/karta",
      "destination": "/lojalnosc.html"
    },
    {
      "source": "/swieta",
      "destination": "/swieta.html"
    }
  ],
  "redirects": [
    {
      "source": "/lunchówki",
      "destination": "/lunchowki",
      "permanent": false
    },
    {
      "source": "/stolik",
      "destination": "/?src=qr-stolik#menu",
      "permanent": false
    },
    {
      "source": "/święta",
      "destination": "/swieta",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "hi-bi.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
